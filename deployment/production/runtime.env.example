# Actual private configuration is .env.production-release.local on the preparation computer.
# Copy privately to /home/randakas/randa-kassis-website/.env during the approved window.
NODE_ENV=production
PORT=8000
BUNNY_STORAGE_ZONE=randa-kassis-website
BUNNY_STORAGE_API_KEY=REPLACE_WITH_PRODUCTION_STORAGE_WRITE_KEY
BUNNY_STORAGE_ENDPOINT=https://storage.bunnycdn.com
BUNNY_CONTENT_ROOT=MDcontent/public
METADATA_DIR=/home/randakas/public_html/metadata
BUILD_DIR=/home/randakas/randa-kassis-website/build
CONTENT_BACKUP_DIR=/home/randakas/randa-production-backups/content
CONTENT_READ_ONLY=true
METADATA_SOURCE_URL=
CONTENT_OVERRIDE_DIR=
LOCAL_PRODUCTION_PREVIEW=false
ADMIN_EMAIL=randakassis@admin.com
ADMIN_PASSWORD=REPLACE_WITH_PRIVATE_PRODUCTION_PASSWORD
ADMIN_SESSION_SECRET=REPLACE_WITH_PRIVATE_RANDOM_SECRET
ADMIN_ORIGIN=https://randakassis.com

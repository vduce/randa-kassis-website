__CPANEL_MANAGED_BLOCKS__
Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
# Canonical production origin also matches the admin cookie/origin policy.
RewriteCond %{HTTP_HOST} ^www\.randakassis\.com$ [NC]
RewriteRule ^ https://randakassis.com%{REQUEST_URI} [R=301,L]
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
RewriteRule ^(?:admins|repositories|node_modules|server)(?:/|$) - [F,L,NC]
RewriteRule ^(?:server\.js|package(?:-lock)?\.json|stderr\.log|public_html-backup.*\.zip)$ - [F,L,NC]
# APIs and metadata must reach Node / their real JSON files, never the SPA fallback.
RewriteRule ^(?:api|metadata)(?:/|$) - [L]
RewriteRule ^\.well-known/acme-challenge/ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.html [L]
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "^(index\.html|.*\.json)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>

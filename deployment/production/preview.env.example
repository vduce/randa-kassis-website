# Copy to .env.production-preview.local, fill credentials locally, chmod 600.
# Never commit the filled file. Use the production zone's READ-ONLY password.
NODE_ENV=production
PORT=3040
HOST=127.0.0.1
LOCAL_PRODUCTION_PREVIEW=true
CONTENT_READ_ONLY=true
BUNNY_STORAGE_ZONE=randa-kassis-website
BUNNY_STORAGE_API_KEY=ADD_PRODUCTION_READ_ONLY_KEY
BUNNY_STORAGE_ENDPOINT=https://storage.bunnycdn.com
BUNNY_CONTENT_ROOT=MDcontent/public
METADATA_SOURCE_URL=https://randakassis.com/metadata
METADATA_DIR=.production-preview/metadata
CONTENT_OVERRIDE_DIR=deployment/production/content-overrides
BUILD_DIR=build-production
BUILD_PATH=build-production
ADMIN_EMAIL=preview@randakassis.local
ADMIN_PASSWORD=ADD_RANDOM_LOCAL_PREVIEW_PASSWORD
ADMIN_SESSION_SECRET=ADD_RANDOM_LOCAL_SESSION_SECRET
ADMIN_ORIGIN=http://localhost:3040
REACT_APP_PROXY_URL=
REACT_APP_API_URL=
REACT_APP_METADATA_URL=
REACT_APP_STORAGE_MODE=bunny
REACT_APP_BUNNY_CONTENT_ROOT=MDcontent/public
REACT_APP_CONTENT_CDN=/api/content
